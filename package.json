{
  "name": "no-more-bs",
  "version": "0.1.0",
  "description": "Bootstrap shared behavioural instructions and skills across Claude Code, Codex, and OpenCode.",
  "license": "MIT",
  "module": "src/index.ts",
  "type": "module",
  "private": false,
  "bin": {
    "no-more-bs": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=node --outfile=dist/index.js",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run scripts/validate-frontmatter.ts && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "latest",
    "@types/diff": "^8.0.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "diff": "^9.0.0"
  }
}
